<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Extra Light -->
    <font
        android:fontStyle="normal"
        android:fontWeight="200"
        android:font="@font/plus_jakarta_sans_extra_light" />
    <font
        android:fontStyle="italic"
        android:fontWeight="200"
        android:font="@font/plus_jakarta_sans_extra_light_italic"/>

    <!-- Light -->
    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/plus_jakarta_sans_light" />
    <font
        android:fontStyle="italic"
        android:fontWeight="300"
        android:font="@font/plus_jakarta_sans_light_italic"/>

    <!-- Regular -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/plus_jakarta_sans_regular" />
    <font
        android:fontStyle="italic"
        android:fontWeight="400"
        android:font="@font/plus_jakarta_sans_italic" />

    <!-- Medium -->
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/plus_jakarta_sans_medium" />
    <font
        android:fontStyle="italic"
        android:fontWeight="500"
        android:font="@font/plus_jakarta_sans_medium_italic" />

    <!-- SemiBold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/plus_jakarta_sans_semi_bold" />
    <font
        android:fontStyle="italic"
        android:fontWeight="600"
        android:font="@font/plus_jakarta_sans_semi_bold_italic" />

    <!-- Bold -->
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/plus_jakarta_sans_bold" />

    <!-- ExtraBold -->
    <font
        android:fontStyle="italic"
        android:fontWeight="800"
        android:font="@font/plus_jakarta_sans_extra_bold" />

</font-family>