<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

    <!-- TODO: Asignar un nombre a la Aplicación -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="esei.uvigo.es.tfg_donakyoin.fragments.SearchFragment"
        android:label="AequoraMed">
        <action
            android:id="@+id/action_searchFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="esei.uvigo.es.tfg_donakyoin.fragments.DetailFragment"
        android:label="Información">
        <argument
            android:name="idMed"
            app:argType="integer" />
        <action
            android:id="@+id/action_detailFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_detailFragment_to_equivalenciasBottomSheet"
            app:destination="@id/equivalenciasBottomSheet" />
    </fragment>

    <dialog
        android:id="@+id/equivalenciasBottomSheet"
        android:name="esei.uvigo.es.tfg_donakyoin.fragments.EquivalenciasBottomSheet"
        android:label="Equivalencias Farmacéuticas">
        <argument
            android:name="idMed"
            app:argType="integer" />
        <action
            android:id="@+id/action_equivalenciasBottomSheet_to_detailFragment"
            app:destination="@id/detailFragment" />
    </dialog>

    <fragment
        android:id="@+id/savedFragment"
        android:name="esei.uvigo.es.tfg_donakyoin.fragments.SavedFragment"
        android:label="AequoraMed" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="esei.uvigo.es.tfg_donakyoin.fragments.SettingsFragment"
        android:label="AequoraMed" />


</navigation>